{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nalaro AI",
  "version": "0.1.0",
  "identifier": "digital.nalaro.ai.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Nalaro AI",
        "width": 1220,
        "height": 790,
        "minWidth": 800,
        "minHeight": 540,
        "backgroundColor": "#FBFAF8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}